{
  "name": "sessionsignal-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SessionSignal public website, teacher portal, Chrome extension, and Supabase migrations",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:extension && npm run package:extension && vite build",
    "build:production": "npm run validate:deployment && npm run build",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.js",
    "check": "npm run test && npm run build && npm run scan:production && npm run smoke:web && npm run audit:dependencies",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high && npm audit --prefix apps/api --audit-level=high",
    "validate:deployment": "node scripts/validate-deployment-env.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:live": "node scripts/smoke-web.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "migrate:sqlite": "node scripts/migrate-sqlite-to-supabase.mjs",
    "scan:production": "node scripts/scan-production.mjs",
    "legacy:dev": "npm run dev --prefix apps/api",
    "legacy:start": "npm run start --prefix apps/api",
    "legacy:setup": "npm install --prefix apps/api"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@supabase/supabase-js": "^2.118.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "vite": "^7.3.7"
  }
}
