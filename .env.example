# Public browser configuration. These values are intentionally available to the
# website/extension; database RLS is the security boundary. Never put a Supabase
# secret/service-role key in a VITE_ or EXTENSION_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Extension build configuration uses the same development/production project.
EXTENSION_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXTENSION_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Required only by the owner-run historical migration command. Do not expose it
# to Vite or include it in extension build output.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
LEGACY_TEACHER_ID=00000000-0000-0000-0000-000000000000
SQLITE_DATABASE_PATH=apps/api/data/sessions.db

# Public support copy. Leave blank rather than publishing a fake address.
VITE_SUPPORT_EMAIL=
